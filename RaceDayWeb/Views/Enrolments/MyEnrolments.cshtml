@model IEnumerable<RaceDayWeb.Models.ParticipantEnrolmentViewModel>
@{
    ViewData["Title"] = "My Enrolments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>My Race Enrolments</h2>
    <a asp-controller="Events" asp-action="Index" class="btn btn-primary">Browse More Events</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (!Model.Any())
{
    <div class="card shadow-sm border-0 text-center p-5">
        <h4 class="text-muted mb-3">You haven't enrolled in any race events yet.</h4>
        <div>
            <a asp-controller="Events" asp-action="Index" class="btn btn-outline-primary">Explore Events</a>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Race Event</th>
                            <th>Category</th>
                            <th>Fee</th>
                            <th>Status</th>
                            <th>Enrolment Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong class="text-primary">@item.EventName</strong></td>
                                <td>@item.CategoryName</td>
                                <td>R @item.Fee</td>
                                <td>
                                    <span class="badge @(item.EnrolmentStatus == "Confirmed" ? "bg-success" : "bg-warning text-dark")">
                                        @item.EnrolmentStatus
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
